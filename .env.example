## Copy to .env and fill in your real keys. .env itself is gitignored.

NVIDIA_API_KEY=nvapi-...

# NVIDIA NIM (https://integrate.api.nvidia.com/v1), OpenAI-compatible.
# server/services/ai.js tries a chain of models in order (MODEL_CHAIN) so a
# single model being rate-limited or down doesn't stall generation.

# How many files generate concurrently — see server/services/ai.js.
AI_MAX_CONCURRENCY=2

# Places API (New) — bills per request past a small free monthly allowance,
# unlike the OpenRouter key above. GOOGLE_PLACES_DAILY_CAP is a hard stop
# enforced in server/services/places.js.
GOOGLE_PLACES_API_KEY=AIzaSy...
GOOGLE_PLACES_DAILY_CAP=50

# Repeat searches (or the same search with a different rating/review
# filter) are served from server/data/db.json instead of paying Google
# again, until this many days pass.
GOOGLE_PLACES_CACHE_TTL_DAYS=30
